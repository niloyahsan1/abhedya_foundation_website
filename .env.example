# Environment & URLs
# For Local:
APP_NAME="Abhedya Foundation"
APP_ENV="local"
APP_KEY=""
APP_DEBUG=true
APP_URL="http://localhost:8000"
# For Production:
# APP_ENV="production"
# APP_DEBUG=false
# APP_URL="https://abhedyafoundation.org"

# Subdomain / Portal Configuration
# For Local:
PORTAL_URL="http://portal.localhost:8000"
PORTAL_DOMAIN="portal.localhost"
SESSION_DOMAIN=null
# For Production:
# PORTAL_URL="https://portal.abhedyafoundation.org"
# PORTAL_DOMAIN="portal.abhedyafoundation.org"
# SESSION_DOMAIN=".abhedyafoundation.org"

APP_TIMEZONE="Asia/Dhaka"
APP_LOCALE="bn"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="en_US"

APP_MAINTENANCE_DRIVER="file"
BCRYPT_ROUNDS=12

LOG_CHANNEL="stack"
LOG_STACK="single"
LOG_DEPRECATIONS_CHANNEL=null
# Local: LOG_LEVEL="debug" | Production: LOG_LEVEL="error"
LOG_LEVEL="debug"

# Database Configuration
# Local development (XAMPP / MySQL):
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="abhedya_foundation"
DB_USERNAME="root"
DB_PASSWORD=""
# Live cPanel MySQL:
# DB_DATABASE="beyougoc_abhedya"
# DB_USERNAME="beyougoc_dbuser"
# DB_PASSWORD="#e_j82mzvbYJ2e2"

SESSION_DRIVER="database"
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH="/"
SESSION_DOMAIN=null

BROADCAST_CONNECTION="log"
FILESYSTEM_DISK="local"
QUEUE_CONNECTION="database"
CACHE_STORE="database"

MEMCACHED_HOST="127.0.0.1"

REDIS_CLIENT="phpredis"
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER="log"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@abhedyafoundation.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION="us-east-1"
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tyro Dashboard & Portal Settings
TYRO_DASHBOARD_APP_NAME="Abhedya Foundation"
TYRO_DASHBOARD_ENABLE_EMAILER="false"
TYRO_DASHBOARD_NOTIFICATION_STYLE="toast"
TYRO_LOGIN_APP_NAME="Abhedya Foundation"
